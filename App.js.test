import React, { useEffect, useState } from 'react';
import { View, ActivityIndicator, StyleSheet, Text, Button, SafeAreaView } from 'react-native';
import { Provider as PaperProvider } from 'react-native-paper';
import AsyncStorage from '@react-native-async-storage/async-storage';
import { SimpleLoadingProvider, useSimpleLoading } from './src/contexts/SimpleLoadingContext';
import SimpleLoadingOverlay from './src/components/SimpleLoadingOverlay';

export default function App() {
  const [isLoading, setIsLoading] = useState(true);
  const [error, setError] = useState(null);

  useEffect(() => {
    initializeApp();
  }, []);

  const initializeApp = async () => {
    try {
      console.log('App starting...');
      // Simple storage check
      await AsyncStorage.getItem('test');
      console.log('Storage check passed');
    } catch (err) {
      console.error('App init error:', err);
      setError('App initialization failed');
    } finally {
      setTimeout(() => {
        setIsLoading(false);
      }, 2000);
    }
  };

  if (error) {
    return (
      <SimpleLoadingProvider>
        <SafeAreaView style={styles.container}>
          <View style={styles.centerContainer}>
            <Text style={styles.errorText}>Error: {error}</Text>
            <Button title="Retry" onPress={() => setError(null)} />
          </View>
          <SimpleLoadingOverlay />
        </SafeAreaView>
      </SimpleLoadingProvider>
    );
  }

  if (isLoading) {
    return (
      <SimpleLoadingProvider>
        <SafeAreaView style={styles.container}>
          <View style={styles.centerContainer}>
            <ActivityIndicator size="large" color="#2563EB" />
            <Text style={styles.loadingText}>Loading...</Text>
          </View>
          <SimpleLoadingOverlay />
        </SafeAreaView>
      </SimpleLoadingProvider>
    );
  }

  return (
    <SimpleLoadingProvider>
      <SafeAreaView style={styles.container}>
        <PaperProvider>
          <MainApp />
        </PaperProvider>
        <SimpleLoadingOverlay />
      </SafeAreaView>
    </SimpleLoadingProvider>
  );
}

const MainApp = () => {
  const { showLoading, hideLoading } = useSimpleLoading();

  const handleDashboard = () => {
    showLoading('Opening Dashboard...');
    setTimeout(() => {
      hideLoading();
      console.log('Navigate to Dashboard');
    }, 1500);
  };

  const handleInventory = () => {
    showLoading('Loading Inventory...');
    setTimeout(() => {
      hideLoading();
      console.log('Navigate to Inventory');
    }, 1500);
  };

  const handleBilling = () => {
    showLoading('Opening Billing...');
    setTimeout(() => {
      hideLoading();
      console.log('Navigate to Billing');
    }, 1500);
  };

  return (
    <View style={styles.centerContainer}>
      <Text style={styles.title}>Binest App</Text>
      <Text style={styles.subtitle}>Your Business Management App</Text>
      <View style={styles.buttonContainer}>
        <Button 
          title="Dashboard" 
          onPress={handleDashboard}
          color="#2563EB"
        />
        <Button 
          title="Inventory" 
          onPress={handleInventory}
          color="#10B981"
        />
        <Button 
          title="Billing" 
          onPress={handleBilling}
          color="#F59E0B"
        />
      </View>
    </View>
  );
};

const styles = StyleSheet.create({
  container: {
    flex: 1,
    backgroundColor: '#f8f9fa',
  },
  centerContainer: {
    flex: 1,
    justifyContent: 'center',
    alignItems: 'center',
    padding: 20,
  },
  loadingText: {
    marginTop: 10,
    color: '#2563EB',
    fontSize: 16,
  },
  errorText: {
    color: '#dc3545',
    fontSize: 16,
    marginBottom: 20,
    textAlign: 'center',
  },
  title: {
    fontSize: 24,
    fontWeight: 'bold',
    color: '#1E293B',
    marginBottom: 10,
  },
  subtitle: {
    fontSize: 16,
    color: '#64748B',
    marginBottom: 30,
    textAlign: 'center',
  },
  buttonContainer: {
    width: '100%',
    maxWidth: 300,
  },
});
